# ─────────────────────────────────────────────────────────────────────────────
# ViralClip AI - environment variables
# Copy to .env and fill in what you need:   cp .env.example .env
# NEVER commit your real .env (it is in .gitignore).
# API keys can also be entered on the Settings page (stored encrypted).
# ─────────────────────────────────────────────────────────────────────────────

# --- API keys ----------------------------------------------------------------
# YouTube Data API v3 (creator search, video metadata, comments). Free: 10,000 units/day.
YOUTUBE_API_KEY=
# OpenAI: Whisper transcription and/or GPT scoring.
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint (OpenRouter, a local Ollama/vLLM server, ...)
OPENAI_BASE_URL=
# Anthropic: Claude scoring.
ANTHROPIC_API_KEY=

# --- AI choices (all can be changed on the Settings page) -----------------------
# auto | openai | anthropic | heuristic   (auto = OpenAI if key, else Anthropic, else local heuristic)
LLM_PROVIDER=auto
# Leave empty for defaults: Anthropic claude-haiku-4-5 / claude-opus-5-5, OpenAI gpt-5-mini / gpt-5
LLM_MODEL_FAST=
LLM_MODEL_SMART=
# auto | openai | faster_whisper | none
TRANSCRIBER=auto
WHISPER_MODEL=whisper-1
FASTER_WHISPER_MODEL=small
EMBEDDING_MODEL=text-embedding-3-small

# --- Database ------------------------------------------------------------------
# Local development defaults to SQLite in ./data. Docker Compose sets PostgreSQL automatically.
# Supabase / any Postgres:  postgresql://user:password@host:5432/dbname
DATABASE_URL=
POSTGRES_USER=viralclip
POSTGRES_PASSWORD=change-me
POSTGRES_DB=viralclip

# --- Storage -------------------------------------------------------------------
# local (./data/storage) or s3 (AWS S3, Cloudflare R2, MinIO, Supabase Storage S3 endpoint)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Optional public/CDN base URL for the bucket; otherwise presigned URLs are used
S3_PUBLIC_BASE_URL=

# --- Security --------------------------------------------------------------------
# Encrypts API keys entered in the dashboard. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Bearer token the dashboard uses to talk to the API (set in production).
API_AUTH_TOKEN=
# HTTP Basic auth for the whole dashboard (set in production). User defaults to "admin".
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Allowed browser origins for direct API calls (the dashboard itself uses a same-origin proxy)
CORS_ORIGINS=http://localhost:3000

# --- Misc ------------------------------------------------------------------------
APP_TIMEZONE=Europe/Amsterdam
# Frontend -> backend URL (server-side only). Docker Compose sets http://api:8000.
BACKEND_URL=http://localhost:8000
WEB_PORT=3000
# Build the Docker image with local faster-whisper (free transcription, bigger image)
INSTALL_LOCAL_WHISPER=false
