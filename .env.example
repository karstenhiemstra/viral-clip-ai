# ─────────────────────────────────────────────────────────────────────────────
# ViralClip AI - instellingen
# Kopieer dit bestand naar .env en vul alleen in wat je nodig hebt:
#     cp .env.example .env
# Zet NOOIT je echte .env in Git (staat in .gitignore; `make secrets` controleert het).
# Alle API keys kun je ook later invullen in de app: Instellingen → API keys
# (dan worden ze versleuteld in de database opgeslagen).
# ─────────────────────────────────────────────────────────────────────────────

# === 1. API KEYS ==============================================================
# [NODIG]  YouTube Data API v3 - creators zoeken en nieuwe video's vinden. Gratis (10.000 units/dag).
#          console.cloud.google.com → project → "YouTube Data API v3" inschakelen → Credentials → API key
YOUTUBE_API_KEY=

# [AANBEVOLEN, betaald] OpenAI - één key voor transcriptie (Whisper) én de slimme clipselectie.
#          platform.openai.com → API keys → Create new secret key (en tegoed toevoegen bij Billing)
OPENAI_API_KEY=

# [OPTIONEEL] Alleen invullen als je Claude wilt gebruiken in plaats van OpenAI.
#          Anthropic kan niet transcriberen: dan transcribeert de app lokaal (faster-whisper) of via .srt.
ANTHROPIC_API_KEY=

# [OPTIONEEL] Alleen voor een OpenAI-compatibele server (OpenRouter, lokale Ollama/vLLM, ...).
# Laat dit uitgeschakeld (met # ervoor) om gewoon OpenAI te gebruiken.
# OPENAI_BASE_URL=https://api.openai.com/v1

# === 2. AI-KEUZES (ook te wijzigen in Instellingen → AI & modellen) ============
# auto | openai | anthropic | heuristic   (auto = OpenAI als die key er is, anders Anthropic, anders gratis heuristiek)
LLM_PROVIDER=auto
# budget | balanced | best   (balanced = goedkoop model leest alles, slim model beoordeelt alleen ~30 kandidaten)
LLM_QUALITY=balanced
# Leeg laten = model volgt LLM_QUALITY (OpenAI: gpt-5-mini / gpt-5, Anthropic: claude-haiku-4-5 / claude-sonnet-5-5)
LLM_MODEL_FAST=
LLM_MODEL_SMART=
# auto | openai | faster_whisper | none
TRANSCRIBER=auto
# Captions blijven ALTIJD in de gesproken taal (de taal wordt automatisch herkend, ook per zin bij gemengde
# talen). Niet vertalen: laat dit op false staan.
TRANSLATE_CAPTIONS=false
WHISPER_MODEL=whisper-1
FASTER_WHISPER_MODEL=small
EMBEDDING_MODEL=text-embedding-3-small

# === 3. BEVEILIGING (nodig zodra de app van buiten je eigen computer bereikbaar is) =====
# Versleutelt API keys die je in de app invult. Leeg = wordt automatisch aangemaakt in ./data.
# Zelf maken:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Wachtwoord voor het hele dashboard (gebruikersnaam: DASHBOARD_USER).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Geheime sleutel tussen dashboard en API. Maak er één met hetzelfde commando als hierboven.
API_AUTH_TOKEN=
# Browser-origins die de API direct mogen aanroepen (het dashboard zelf gebruikt een eigen proxy)
CORS_ORIGINS=http://localhost:3000
# Maximale grootte van een upload of deel-link-download
MAX_UPLOAD_GB=20

# === 4. DATABASE (standaard goed, niets aan veranderen) ==========================
# Lokaal: leeg = SQLite in ./data. Docker Compose gebruikt automatisch PostgreSQL.
# Supabase / eigen Postgres:  postgresql://gebruiker:wachtwoord@host:5432/dbnaam
DATABASE_URL=
POSTGRES_USER=viralclip
POSTGRES_PASSWORD=change-me
POSTGRES_DB=viralclip

# === 5. OPSLAG (standaard goed) ===================================================
# local (./data/storage) of s3 (AWS S3, Cloudflare R2, MinIO, Supabase Storage S3-endpoint)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Optionele publieke/CDN-URL van de bucket; anders worden tijdelijke (presigned) links gebruikt
S3_PUBLIC_BASE_URL=

# === 6. OVERIG =========================================================================
APP_TIMEZONE=Europe/Amsterdam
# Dashboard → API (alleen server-side). Docker Compose zet dit zelf op http://api:8000.
BACKEND_URL=http://localhost:8000
WEB_PORT=3000
# Docker-image bouwen met lokale faster-whisper (gratis transcriptie, grotere image)
INSTALL_LOCAL_WHISPER=false
